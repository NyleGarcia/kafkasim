                  "b": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "ms": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "at",
                  "a",
                  "b",
                  "ms"
