{
  "schemaVersion": 1,
  "name": "Cluster Linking DR (Confluent)",
  "description": "Two independent clusters. DR brokers fetch byte-for-byte from the primary over the WAN (no Connect), so mirror offsets equal source offsets. All primary brokers die at 20s. At 25s the mirror is promoted: RPO is the acknowledged records the link had not copied yet.",
  "requiresConfluent": true,
  "durationMs": 40000,
  "regions": [
    {
      "id": "east",
      "name": "Primary (US-East)"
    },
    {
      "id": "west",
      "name": "DR (US-West)"
    }
  ],
  "latency": {
    "interRegionMs": 35
  },
  "clusters": [
    {
      "id": "primary",
      "flavor": "confluent",
      "controllers": [
        {
          "id": "pc1",
          "region": "east"
        },
        {
          "id": "pc2",
          "region": "east"
        },
        {
          "id": "pc3",
          "region": "east"
        }
      ],
      "brokers": [
        {
          "id": "pb1",
          "region": "east"
        },
        {
          "id": "pb2",
          "region": "east"
        },
        {
          "id": "pb3",
          "region": "east"
        }
      ],
      "config": {
        "minInsyncReplicas": 2
      }
    },
    {
      "id": "dr",
      "flavor": "confluent",
      "controllers": [
        {
          "id": "dc1",
          "region": "west"
        },
        {
          "id": "dc2",
          "region": "west"
        },
        {
          "id": "dc3",
          "region": "west"
        }
      ],
      "brokers": [
        {
          "id": "db1",
          "region": "west"
        },
        {
          "id": "db2",
          "region": "west"
        },
        {
          "id": "db3",
          "region": "west"
        }
      ],
      "config": {
        "minInsyncReplicas": 2
      }
    }
  ],
  "topics": [
    {
      "cluster": "primary",
      "name": "orders",
      "partitions": 2,
      "replicationFactor": 3
    },
    {
      "cluster": "dr",
      "name": "orders",
      "partitions": 2,
      "replicationFactor": 3,
      "mirror": {
        "type": "cluster_link",
        "sourceCluster": "primary",
        "sourceTopic": "orders",
        "fetchIntervalMs": 500
      }
    }
  ],
  "producers": [
    {
      "id": "shop",
      "cluster": "primary",
      "region": "east",
      "topic": "orders",
      "acks": "all",
      "ratePerSec": 50
    }
  ],
  "actions": [
    {
      "type": "KILL_NODE",
      "at": 20000,
      "node": "pb1"
    },
    {
      "type": "KILL_NODE",
      "at": 20000,
      "node": "pb2"
    },
    {
      "type": "KILL_NODE",
      "at": 20000,
      "node": "pb3"
    },
    {
      "type": "FAILOVER",
      "at": 25000,
      "cluster": "dr",
      "topic": "orders"
    }
  ]
}
